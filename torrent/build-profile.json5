{
  "apiType": "stageMode",
  "buildOption": {
    "sourceOption": {
      "workers": [
        "./src/main/ets/workers/TorrentWorker.ets"
      ]
    },
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "-DOHOS_STL=c++_static",
      "cppFlags": "",
      "abiFilters": [
        "arm64-v8a",
        "x86_64"
      ]
    },
  },
  "buildOptionSet": [
    {
      "name": "release",
      "externalNativeOptions": {
        "abiFilters": [
          "arm64-v8a"
        ]
      }
    },
  ],
  "targets": [
    {
      "name": "default"
    }
  ]
}
